<% content_for :title, "Chat" %>

<section class="w-full max-w-3xl mx-auto flex flex-col h-[calc(100vh-10rem)]"
         data-controller="chat"
         data-chat-current-user-id-value="<%= Current.user.id %>">
  <div class="flex items-baseline justify-between">
    <h1 class="font-bold text-3xl">Chat</h1>
    <p class="text-sm text-gray-500" data-chat-target="status">Connecting…</p>
  </div>

  <ol id="messages" class="flex-1 overflow-y-auto mt-4 space-y-4 p-4 bg-gray-100 rounded-lg" data-chat-target="messages">
    <%= render partial: "messages/message", collection: @messages, as: :message %>
  </ol>

  <form class="mt-4 flex gap-2" data-action="submit->chat#send">
    <label for="message_body" class="sr-only">Message</label>
    <input type="text" id="message_body" autocomplete="off" disabled required
           maxlength="<%= Message::MAXIMUM_LENGTH %>" placeholder="Write a message…"
           class="flex-1 shadow-sm rounded-md border border-gray-400 bg-white focus:outline-blue-600 px-3 py-2 disabled:bg-gray-100"
           data-chat-target="input">
    <button type="submit" disabled
            class="rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer disabled:opacity-50"
            data-chat-target="button">Send</button>
  </form>

  <p class="mt-2 text-sm text-red-600 hidden" data-chat-target="error" role="alert"></p>
</section>
